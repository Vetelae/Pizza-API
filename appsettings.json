{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "Business": {
        "TimeZoneId": "Europe/Helsinki"
    },
    "LoginSecurity": {
        "IpPermitLimit": 20,
        "IpWindowSeconds": 60,
        "IpSegmentsPerWindow": 6,
        "AccountMaxFailedAttempts": 5,
        "AccountObservationWindowMinutes": 5,
        "LockoutDurationsMinutes": [ 5, 15, 60 ],
        "EscalationResetHours": 24
    },
    "AuthRateLimiting": {
        "Register": {
            "PermitLimit": 5,
            "WindowSeconds": 600,
            "SegmentsPerWindow": 10
        },
        "ForgotPassword": {
            "PermitLimit": 5,
            "WindowSeconds": 600,
            "SegmentsPerWindow": 10
        },
        "ResetPassword": {
            "PermitLimit": 10,
            "WindowSeconds": 600,
            "SegmentsPerWindow": 10
        },
        "ConfirmEmail": {
            "PermitLimit": 10,
            "WindowSeconds": 600,
            "SegmentsPerWindow": 10
        },
        "Refresh": {
            "PermitLimit": 30,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "Logout": {
            "PermitLimit": 30,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "ForgotPasswordAccountCooldownMinutes": 15
    },
    "TrafficRateLimiting": {
        "Global": {
            "PermitLimit": 600,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "PublicReads": {
            "PermitLimit": 240,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "CartReads": {
            "PermitLimit": 60,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "CartMutations": {
            "PermitLimit": 30,
            "WindowSeconds": 60,
            "SegmentsPerWindow": 6
        },
        "Checkout": {
            "PermitLimit": 5,
            "WindowSeconds": 600,
            "SegmentsPerWindow": 10
        }
    },
    "ReverseProxy": {
        "Enabled": false,
        "ForwardLimit": 1,
        "KnownProxies": [],
        "KnownNetworks": []
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": ""
    }
}
